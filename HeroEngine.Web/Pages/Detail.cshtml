@page "{name}"
@model HeroEngine.Web.Pages.DetailModel
@{
    ViewData["Title"] = "Detalle del Héroe";
}
<h1>Detalles de @Model.HeroSelected.Name</h1>
<h3>Clase : [@Model.HeroSelected.GetType().Name]</h3>
<h3>Level : @Model.HeroSelected.Level</h3>
<h3>Health : @Model.HeroSelected.Health</h3>

<h2>Habilidades:</h2>
<table>
    <thead>
        <tr>
            <th>Slot 1</th>
            <th>Slot 2</th>
            <th>Slot 3</th>
            <th>Slot 4</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            @foreach (var skill in Model.HeroSelected.Skills)
            {
            <th><p>@(skill.Name != null ? @skill.Name : "Vacio")</p>
                <p>@(skill.Rarity != null ? @skill.Rarity : "Desconocido")</p>
            </th>
            }
        </tr>
    </tbody>
</table>